[Unit]
Description=LessonSearch FastAPI Server
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=180
StartLimitBurst=12

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/lesson-search/current/server
ExecStartPre=/opt/lesson-search/current/venv/bin/python -m deploy.preflight
ExecStart=/opt/lesson-search/current/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --limit-max-requests 1000
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=APP_ENV=production
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# 内存限制，避免抢博客资源
MemoryMax=256M

[Install]
WantedBy=multi-user.target
